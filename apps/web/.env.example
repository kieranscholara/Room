# Local development with `npm run setup:local` and `npm run db:migrate`.
# Credentials are read server-side from the ignored local CLI status file.
ROOMSELL_LOCAL_SUPABASE=1
ROOMSELL_ENABLE_DEMO=1
# Filesystem storage is used only by the synthetic /demo editor.
# Paths are relative to apps/web when using the npm dev/start scripts.
ROOMSELL_DATA_DIR=.local

# For a hosted Supabase deployment, remove ROOMSELL_LOCAL_SUPABASE and set
# these server-only variables in the hosting provider's secret settings.
# Do not commit real values or prefix the service-role key with NEXT_PUBLIC_.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# Inventory connector credentials are encrypted with a server-only 32-byte base64 key.
# Generate once using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Store in the hosting provider's secrets. Keep it stable and backed up securely.
# ROOMSELL_CONNECTOR_ENCRYPTION_KEY=

# Hosted application origin and worker authentication (server-only).
# ROOMSELL_PUBLIC_ORIGIN=https://your-domain.example
# CRON_SECRET=
# ROOMSELL_WORKER_TOKEN=
# Optional OpenAI provider; never needed for the explicit local test adapter.
# OPENAI_API_KEY=
# ROOMSELL_AI_MODEL=gpt-4.1-mini
# ROOMSELL_IMAGE_MODEL=gpt-image-1
# Local-only synthetic test accounts; enabled by seed:test-customer. Never set on hosting.
# ROOMSELL_ENABLE_TEST_CUSTOMER=1
