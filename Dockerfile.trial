FROM docker:28-cli AS docker-client
FROM node:24-bookworm-slim

COPY --from=docker-client /usr/local/bin/docker /usr/local/bin/docker
WORKDIR /workspace/Room
ENV npm_execpath=/usr/local/lib/node_modules/npm/bin/npm-cli.js

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/ packages/
RUN --mount=type=secret,id=network_ca \
    if [ -f /run/secrets/network_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/network_ca; fi; \
    export NODE_USE_ENV_PROXY=1; \
    npm ci --no-audit --no-fund
COPY . .

EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=180s --retries=8 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/testing/status').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "scripts/try-customer.mjs"]
