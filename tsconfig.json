{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@roomsell/catalogue": ["packages/catalogue/src/index.ts"],
      "@roomsell/catalogue/assets": ["packages/catalogue/src/assets.ts"],
      "@roomsell/scene-core": ["packages/scene-core/src/index.ts"],
      "@roomsell/geometry": ["packages/geometry/src/index.ts"],
      "@roomsell/layout-engine": ["packages/layout-engine/src/index.ts"],
      "@roomsell/ui": ["packages/ui/src/index.tsx"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tests/**/*.ts",
    "*.ts"
  ],
  "exclude": ["node_modules", "apps/web/.next"]
}
